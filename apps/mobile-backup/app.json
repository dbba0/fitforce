{
  "expo": {
    "name": "FitPulse",
    "slug": "fitpulse",
    "scheme": "fitpulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B1220"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitpulse.mobile"
    },
    "android": {
      "package": "com.fitpulse.mobile"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
